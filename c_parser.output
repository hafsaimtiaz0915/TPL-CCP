Grammar

    0 $accept: program $end

    1 program: /* empty */
    2        | program declaration

    3 declaration: var_declaration
    4            | function_declaration

    5 var_declaration: type_specifier IDENTIFIER ';'
    6                | type_specifier IDENTIFIER '=' expression ';'
    7                | type_specifier IDENTIFIER '[' NUMBER ']' ';'

    8 type_specifier: INT
    9               | FLOAT
   10               | CHAR
   11               | VOID

   12 parameter_list: type_specifier IDENTIFIER
   13               | parameter_list ',' type_specifier IDENTIFIER

   14 $@1: /* empty */

   15 function_declaration: type_specifier IDENTIFIER '(' ')' '{' $@1 statement_list '}'

   16 $@2: /* empty */

   17 function_declaration: type_specifier IDENTIFIER '(' parameter_list ')' '{' $@2 statement_list '}'

   18 statement_list: /* empty */
   19               | statement_list statement

   20 statement: matched_statement
   21          | unmatched_statement

   22 matched_statement: expression ';'
   23                  | var_declaration

   24 $@3: /* empty */

   25 matched_statement: '{' $@3 statement_list '}'
   26                  | if_matched
   27                  | while_statement
   28                  | for_statement
   29                  | BREAK ';'
   30                  | CONTINUE ';'
   31                  | RETURN ';'
   32                  | RETURN expression ';'

   33 unmatched_statement: if_unmatched

   34 $@4: /* empty */

   35 $@5: /* empty */

   36 if_matched: IF '(' expression ')' $@4 matched_statement ELSE $@5 matched_statement

   37 $@6: /* empty */

   38 if_unmatched: IF '(' expression ')' $@6 statement

   39 $@7: /* empty */

   40 $@8: /* empty */

   41 if_unmatched: IF '(' expression ')' $@7 matched_statement ELSE $@8 unmatched_statement

   42 $@9: /* empty */

   43 $@10: /* empty */

   44 while_statement: WHILE '(' $@9 expression ')' $@10 statement

   45 $@11: /* empty */

   46 $@12: /* empty */

   47 $@13: /* empty */

   48 for_statement: FOR '(' expression ';' $@11 expression ';' $@12 expression ')' $@13 statement

   49 expression: IDENTIFIER
   50           | NUMBER
   51           | expression '+' expression
   52           | expression '-' expression
   53           | expression '*' expression
   54           | expression '/' expression
   55           | expression '%' expression
   56           | expression EQ_OP expression
   57           | expression NE_OP expression
   58           | expression '<' expression
   59           | expression '>' expression
   60           | expression LE_OP expression
   61           | expression GE_OP expression
   62           | expression AND_OP expression
   63           | expression OR_OP expression
   64           | '-' expression
   65           | '!' expression
   66           | '(' expression ')'
   67           | IDENTIFIER '=' expression


